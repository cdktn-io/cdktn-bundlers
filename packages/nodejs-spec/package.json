{
  "name": "@cdktn/bundler-nodejs-spec",
  "version": "0.0.0",
  "description": "Bundler-agnostic Node.js bundling contract for CDK Terrain L2 libraries (esbuild, Rolldown, ...)",
  "license": "MPL-2.0",
  "author": {
    "name": "cdktn-io",
    "url": "https://cdktn.io",
    "organization": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cdktn-io/cdktn-bundlers.git",
    "directory": "packages/nodejs-spec"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    ".jsii"
  ],
  "scripts": {
    "build": "jsii",
    "package": "jsii-pacmak",
    "test": "jest"
  },
  "peerDependencies": {
    "cdktn": "^0.25.0",
    "constructs": "^10.6.0"
  },
  "devDependencies": {
    "cdktn": "0.25.0",
    "constructs": "10.6.0",
    "jest": "29.7.0",
    "ts-jest": "29.4.14",
    "@types/jest": "29.5.14"
  },
  "jsii": {
    "outdir": "dist",
    "tsc": {
      "outDir": "lib",
      "rootDir": "src"
    },
    "excludeTypescript": [
      "src/**/__tests__/**"
    ],
    "targets": {
      "python": {
        "distName": "cdktn-bundler-nodejs-spec",
        "module": "cdktn_bundler_nodejs_spec"
      },
      "java": {
        "package": "io.cdktn.bundler.nodejsspec",
        "maven": {
          "groupId": "io.cdktn",
          "artifactId": "cdktn-bundler-nodejs-spec"
        }
      },
      "go": {
        "moduleName": "github.com/cdktn-io/cdktn-bundlers-go",
        "packageName": "nodejsspec"
      }
    }
  }
}
