{
  "name": "cdktn-bundlers",
  "private": true,
  "license": "MPL-2.0",
  "description": "Monorepo of cdktn-team-maintained asset bundlers (IAssetBundler implementations) for CDK Terrain",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "package": "pnpm -r --if-present run package",
    "check": "node scripts/release.mjs check",
    "collect": "node scripts/release.mjs collect",
    "plan": "node scripts/release.mjs plan"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsii": "~5.9.55",
    "jsii-pacmak": "^1.141.0",
    "publib": "0.3.6",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.14.0"
  }
}
